# Efflux runs with zero environment variables: every CoinMarketCap call goes
# through the keyless public API (https://pro-api.coinmarketcap.com/public-api).

# Optional. When set, lib/cmc.ts sends the same DEX paths to the keyed
# pro-api host with the X-CMC_PRO_API_KEY header, which avoids the shared
# keyless rate limit. Get a key at https://coinmarketcap.com/api/ (Developer
# portal, "API Key"). Set it in Vercel project settings, never in the repo.
CMC_PRO_API_KEY=
