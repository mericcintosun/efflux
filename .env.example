# Efflux runs with zero environment variables: the default ADAPTER_MODE is
# fake, which serves the seed tokens in lib/data/seed.ts.

# Data source for pages and API routes.
# fake: serve seed data, no network calls (default when unset).
# real: call CoinMarketCap through the keyless public API
#       (https://pro-api.coinmarketcap.com/public-api) for address lookups.
ADAPTER_MODE=fake

# Optional. When set, lib/cmc.ts sends the same DEX paths to the keyed
# pro-api host with the X-CMC_PRO_API_KEY header, which avoids the shared
# keyless rate limit. Get a key at https://coinmarketcap.com/api/ (Developer
# portal, "API Key"). Set it in Vercel project settings, never in the repo.
CMC_PRO_API_KEY=

# Placeholder. next.config.ts fills this at build time with the brand images
# found in public/brand (names without ".png"), read by lib/brand-files.ts.
# Leave it empty.
NEXT_PUBLIC_BRAND_FILES=
