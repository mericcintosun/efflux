# Efflux runs with zero environment variables: the default ADAPTER_MODE is
# fake, which serves the seed tokens in lib/data/seed.ts.
# lib/config.ts is the only file that reads the CMC and demo names below;
# lib/adapter.ts reads ADAPTER_MODE.

# Data source for pages and API routes.
# fake: serve seed data, no network calls (default when unset).
# real: call CoinMarketCap through the keyless public API
#       (https://pro-api.coinmarketcap.com/public-api) for the demo tokens and
#       for address lookups.
ADAPTER_MODE=fake

# Optional. When set, lib/cmc.ts sends the same DEX paths to the keyed
# pro-api host with the X-CMC_PRO_API_KEY header, which avoids the shared
# keyless rate limit. Get a key at https://coinmarketcap.com/api/ (Developer
# portal, "API Key"). Set it in Vercel project settings, never in the repo.
CMC_PRO_API_KEY=

# Optional. Base token contract loaded live as a demo token in real mode.
# Source: the token page on coinmarketcap.com (contract address). Default: BRETT.
EFFLUX_DEMO_BASE_ADDRESS=0x532f27101965dd16442E59d40670FaF5eBB142E4

# Optional. BNB Chain token contract loaded live in real mode. Source: the
# token page on coinmarketcap.com. Leave empty to keep the seed token for BSC.
EFFLUX_DEMO_BSC_ADDRESS=

# Optional. Solana mint address loaded live in real mode. Source: the token
# page on coinmarketcap.com. Default: BONK.
EFFLUX_DEMO_SOLANA_ADDRESS=DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263

# Placeholder. next.config.ts fills this at build time with the brand images
# found in public/brand (names without ".png"), read by lib/brand-files.ts.
# Leave it empty.
NEXT_PUBLIC_BRAND_FILES=
